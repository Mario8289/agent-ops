#!/bin/bash
# Agent Inbox — one pane that answers "what needs me right now?" for the
# "Agent Ops" Zellij layout.
#
#   ASK    (yellow) a permission request is pending: the agent is blocked on you
#   RUN    (green)  busy timestamp newer than idle: the agent is working
#   IDLE   (yellow) the agent has gone idle: it waits for you
#   FAIL   (red)    the log recorded a failure for the run
#   DEAD   (red)    still busy but no update for 15m: died mid-run
#   STOP   (yellow) the log recorded an INTERRUPTED event for the run
#
# Session state comes from the OpenCode server API (`opencode api session.list`)
# through the adapter below, NOT from the private SQLite schema, so it survives
# OpenCode upgrades. ASK / FAIL / STOP come from the agent-log plugin's log
# (~/agent-runs/agent_health.log): the plugin subscribes to the official event
# stream, and the file is the durable record of why a run ended.
#
# ADAPTER SEAM — each harness is a source adapter (four functions named
# <harness>_fetch / _sessions / _spend / _providers). `source_sessions` emits
# one tab-separated record per session, HARNESS first:
#   harness  id  upd  busy  dir  title  tot  cost  kids  busykids  agent  model
# (upd is epoch seconds). OpenCode and Claude Code ship today; AGENT_SOURCES
# (config) lists which to run, and the inbox merges their rows. A new harness
# only has to add the four functions and its name to AGENT_SOURCES.
#
# TOKENS is the running total for the whole session (input + output + cache read
# + cache write). COST is the provider's reported dollar figure. HRN is the
# harness the session runs in (OC = OpenCode, CC = Claude Code), always shown.
# MODEL is the session's agent and model (e.g. "build/deepseek-v4-pro"; ASCII
# "/" so the padded column width is exact). SUB is how many child
# sessions the run has spawned (yellow when any are busy). TITLE is the session's
# own title; leftover width grows TITLE first, then MODEL, and any remainder
# becomes a gap before TOKENS so the numbers stay right-aligned. GIT is
# its branch plus changed-file count. PR is the open pull request for that branch
# with its CI state ("#12" green = passing, "#12!" red = failing, "#12?" yellow =
# pending/draft, "-" = no open PR).
#
# SUB, PR, GIT, MODEL, TITLE, COST, PROJECT and HARNESS are dropped, in that
# order, when the pane is too narrow (HARNESS goes last — the cc_/ses_ id prefix
# still shows the harness without it). Widening reveals them in reverse, but only
# once there are HYST columns to spare, so a pane parked on a threshold does not
# flap between two layouts. Approximate reveal thresholds (pane columns):
#   HARNESS ~56  PROJECT ~69  COST ~77  TITLE ~94 (also flexes to fill)
#   MODEL ~113  GIT ~128  PR ~136  SUB ~141
# Shrinking is immediate (fit always wins over stability).
#
# A summary line sits above the table: "⚠N need you · M RUN · $X/24h". The
# dollar figure is rolling-24h spend across all sessions, approximated from
# session totals (the API exposes per-session cost, not per-message). Put a
# number in AGENT_BUDGET (config) to turn it red once that cap is reached.
#
# The summary line ends with one meter per subscription, separated by " · ". A
# provider with a usage API (DevPass today, via `agent-limits`) shows a small
# bar for the window closest to its cap: green, yellow from 70%, red from 90%
# with the reset time. A provider with no usage API just reads "ok" until a run
# on it fails with provider.quota, then red "LIMIT <age> ago" until a later run
# on it succeeds (or 24h pass) — "ok" means "no limit seen", not "confirmed
# available". When the line runs out of room the bars go, then the windows, then
# the providers that are fine. The inbox starts `agent-limits refresh` in the
# background once a minute and only reads its cache. Providers to track without
# a meter go in AGENT_LIMITS_TRACK (config), e.g. "google:GG opencode-go:GO"; a
# provider that fails with provider.quota is shown even if it is not listed.
# Tunables (all optional, set in ~/.config/agent-ops/config): AGENT_LIMIT_WARN,
# AGENT_LIMIT_ALERT, AGENT_LIMIT_HOLD, AGENT_LIMITS_REFRESH, AGENT_LIMIT_STALE.
#
# The # column numbers the rows as shown. The IDs are saved in that order to
# $SESSION_LIST (default ~/.cache/opencode-session-list), so `sd 3` deletes row
# 3. Rows re-sort when agent states change: check the number just before you
# type it. SESSION is the full ID — opencode needs it whole, so it is never
# clipped.
#
# The row for the session running in the focused pane is shown in reverse video;
# the mapping comes from the pane title that `so` / `sc` / `sn` set.
#
# Checked every 2s, but redrawn only when something actually changed, so mouse
# selection survives long enough to copy a session ID.
# Machine-specific config written by `configure` (paths, source).
[[ -r "${AGENT_OPS_CONFIG:-$HOME/.config/agent-ops/config}" ]] && source "${AGENT_OPS_CONFIG:-$HOME/.config/agent-ops/config}"

LOG="${AGENT_LOG:-$HOME/agent-runs/agent_health.log}"
BASE_NAME="${AGENT_INBOX_NAME:-Agent Inbox}"
SESSION_LIST="${SESSION_LIST:-${AGENT_SESSION_LIST:-${XDG_CACHE_HOME:-$HOME/.cache}/opencode-session-list}}"
mkdir -p "$(dirname "$SESSION_LIST")"

# ---- adapter seam ----
# Each harness is a source adapter: four functions named <harness>_fetch /
# _sessions / _spend / _providers. source_* below just iterate the harnesses in
# AGENT_SOURCES and concatenate their output, so the renderer stays unaware of
# which harness a row came from. To add a harness, write the four functions and
# add its name to AGENT_SOURCES (config); nothing else changes.
#
# _sessions emits one tab-separated record per session, HARNESS first:
#   harness  id  upd  busy  dir  title  tot  cost  kids  busykids  agent  model
# (upd is epoch seconds). _providers emits "harness<TAB>id<TAB>provider".
AGENT_SOURCES="${AGENT_SOURCES:-opencode}"

# How many sessions to fetch and consider for display, across all harnesses.
# The pane height caps how many of these are actually drawn (see max_rows); this
# caps how many are fetched and ranked. Raise it in config when you run many
# concurrent sessions and a tall pane can show more than the default.
MAX_ROWS="${AGENT_MAX_ROWS:-12}"

# --all: print the full session list once (uncapped, archive filter off, archived
# rows flagged) and exit — no live pane. `sl` calls this to browse the long tail.
# In this mode MAX_ROWS is lifted so every session in the window is considered.
ALL_MODE=0
case ${1:-} in
  --all) ALL_MODE=1; MAX_ROWS=100000 ;;
esac

# Archived set: sessions the user marked "done" with `sa`. Hidden from the live
# pane (but shown, and auto-unarchived, if they go ASK/FAIL/DEAD). One id per
# line. In --all mode the filter is off (ARCHIVED empty) but the marks are still
# read into ARCHIVED_FLAG so the long-tail list can flag those rows.
ARCHIVED_FILE="${AGENT_ARCHIVED_FILE:-$HOME/.config/agent-ops/archived}"
unset ARCHIVED ARCHIVED_FLAG; declare -A ARCHIVED=() ARCHIVED_FLAG=()
# Re-read the archived file from disk, replacing the in-memory set. The live
# pane calls this once per render tick so `sa`/`sl` take effect within one tick
# instead of only on restart; the loop persists its own auto-unarchive changes
# to disk before the next read, so disk stays the source of truth.
load_archived() {
  unset ARCHIVED ARCHIVED_FLAG; declare -gA ARCHIVED=() ARCHIVED_FLAG=()
  [[ -r $ARCHIVED_FILE ]] || return
  while IFS= read -r _aid; do
    [[ -n $_aid ]] || continue
    ARCHIVED_FLAG[$_aid]=1
    (( ALL_MODE )) || ARCHIVED[$_aid]=1
  done < "$ARCHIVED_FILE"
}
load_archived

# ---- opencode: the OpenCode server API ----
OC_ROWS_JQ='.data as $all
  | ($all | map(select((.parentID // null) != null))) as $children
  | $all | map(select((.parentID // null) == null))
  | map(. as $s
      | ($children | map(select(.parentID == $s.id))) as $mine
      | [ "opencode",
          $s.id,
          (($s.time.updated // 0) / 1000 | floor),
          (if (($s.time.busy // 0) > ($s.time.idle // 0)) then 1 else 0 end),
          ($s.location.directory // ""),
          ($s.title // ""),
          (($s.tokens.input // 0) + ($s.tokens.output // 0)
            + ($s.tokens.cache.read // 0) + ($s.tokens.cache.write // 0)),
          ($s.cost // 0),
          ($mine | length),
          ([ $mine[] | select((.time.busy // 0) > (.time.idle // 0)) ] | length),
          ($s.agent // ""),
          ($s.model.id // "") ])
  | sort_by(.[2]) | reverse | .[0:$max]
  | .[] | @tsv'

# Rolling 24h spend across all sessions, approximated from session totals.
OC_SPEND_JQ='[ .data[] | select((.time.updated // 0) > ((now - 86400) * 1000)) | (.cost // 0) ] | add // 0'

# "harness<TAB>id<TAB>provider" for every session (not just the shown rows), so
# a quota failure is pinned on the right provider even for an older session.
OC_PROVIDERS_JQ='.data[] | select((.model.providerID // "") != "") | [ "opencode", .id, .model.providerID ] | @tsv'

_oc_raw=
opencode_fetch()     { _oc_raw=$(opencode api session.list 2>/dev/null); }
opencode_sessions()  { printf '%s' "$_oc_raw" | jq -r --argjson max "$MAX_ROWS" "$OC_ROWS_JQ" 2>/dev/null; }
opencode_spend()     { printf '%s' "$_oc_raw" | jq -r "$OC_SPEND_JQ" 2>/dev/null; }
opencode_providers() { printf '%s' "$_oc_raw" | jq -r "$OC_PROVIDERS_JQ" 2>/dev/null; }

# ---- claude: Claude Code transcripts (~/.claude/projects/*/*.jsonl) ----
# Claude Code has no server to query, so a helper script scrapes the per-session
# JSONL transcripts. It is kept separate from the inbox so the brittle,
# schema-dependent parsing lives in one place; when the transcript format
# changes, only that script needs fixing.
CC_BIN="$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/agent-cc-sessions"
[[ -x $CC_BIN ]] || CC_BIN=$(command -v agent-cc-sessions 2>/dev/null || true)
claude_fetch()     { :; }   # the helper reads the filesystem directly
claude_sessions()  { [[ -n $CC_BIN ]] && CC_MAX="$MAX_ROWS" "$CC_BIN" sessions 2>/dev/null; }
claude_spend()     { [[ -n $CC_BIN ]] && CC_MAX="$MAX_ROWS" "$CC_BIN" spend 2>/dev/null; }
claude_providers() { [[ -n $CC_BIN ]] && CC_MAX="$MAX_ROWS" "$CC_BIN" providers 2>/dev/null; }

# ---- dispatchers: run every enabled harness, concatenate ----
source_fetch() { local h; for h in $AGENT_SOURCES; do "${h}_fetch"; done; }
source_sessions() {
  local h
  for h in $AGENT_SOURCES; do "${h}_sessions"; done |
    sort -t$'\t' -k3,3nr | head -n "$MAX_ROWS"
}
source_spend() {
  local h total=0 s
  for h in $AGENT_SOURCES; do
    s=$("${h}_spend"); [[ $s =~ ^-?[0-9] ]] || s=0
    total=$(awk -v a="$total" -v b="$s" 'BEGIN { printf "%.6f", a + b }')
  done
  printf '%s' "$total"
}
source_providers() { local h; for h in $AGENT_SOURCES; do "${h}_providers"; done; }

# Optional daily budget in dollars. When set and the 24h spend reaches it, the
# summary line's spend turns red. AGENT_BUDGET in the config (e.g. 4.64); the
# older one-line budget file still works. Absent = no threshold.
BUDGET_FILE="${AGENT_BUDGET_FILE:-$HOME/.config/agent-ops/budget}"

if [[ -t 1 ]]; then
  green=$(tput setaf 2 2>/dev/null) yellow=$(tput setaf 3 2>/dev/null) red=$(tput setaf 1 2>/dev/null)
  dim=$(tput dim 2>/dev/null) bold=$(tput bold 2>/dev/null) rev=$(tput rev 2>/dev/null) off=$(tput sgr0 2>/dev/null)
fi

# 949133 -> 949k, 1234567 -> 1.2M
human() {
  local n=${1:-0}
  if (( n < 1000 )); then printf '%d' "$n"
  elif (( n < 1000000 )); then printf '%dk' $(( n / 1000 ))
  else printf '%d.%dM' $(( n / 1000000 )) $(( (n % 1000000) / 100000 ))
  fi
}

# Clip to n characters without cutting mid-word or mid-byte. The ellipsis is
# ASCII "..." (not U+2026 "…"): bash's `printf %-Ns` pads by byte count, so a
# 3-byte "…" that renders as one column would leave the field two columns short.
clip() {
  local s=$1 n=$2
  if (( ${#s} > n )); then printf '%s' "${s:0:n-3}..."; else printf '%s' "$s"; fi
}

# Harness name -> two-letter column label.
harness_label() {
  case $1 in
    opencode) printf 'OC' ;;
    claude)   printf 'CC' ;;
    *)        local u=${1^^}; printf '%s' "${u:0:2}" ;;
  esac
}

prev=
prev_title=

# ---- limits line ----
LIMITS_DIR="${AGENT_LIMITS_DIR:-${XDG_CACHE_HOME:-$HOME/.cache}/agent-ops/limits}"
LIMITS_PROVIDERS="${AGENT_LIMITS_PROVIDERS:-$HOME/.config/agent-ops/limits-providers}"
LIMIT_WARN=${AGENT_LIMIT_WARN:-70}
LIMIT_ALERT=${AGENT_LIMIT_ALERT:-90}
LIMIT_HOLD=${AGENT_LIMIT_HOLD:-86400}      # a quota failure with no later success is trusted this long
LIMITS_REFRESH=${AGENT_LIMITS_REFRESH:-60} # seconds between background `agent-limits refresh`
STALE=${AGENT_LIMIT_STALE:-300}            # a meter this old is shown dimmed
LIMITS_BIN="$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/agent-limits"
[[ -x $LIMITS_BIN ]] || LIMITS_BIN=$(command -v agent-limits 2>/dev/null || true)
last_refresh=0

# Provider ID -> two-letter label for providers we do not meter.
short_label() {
  case $1 in
    google|google-vertex) printf 'GG' ;;
    opencode-go)          printf 'GO' ;;
    opencode)             printf 'OC' ;;
    anthropic)            printf 'CC' ;;
    openai)               printf 'OA' ;;
    devpass)              printf 'DP' ;;
    *) local u=${1^^}; printf '%s' "${u:0:2}" ;;
  esac
}

# 3700 -> 1h1m, 540 -> 9m, 200000 -> 2d
dur() {
  local s=${1:-0}
  (( s < 0 )) && s=0
  if (( s < 3600 )); then printf '%dm' $(( s / 60 ))
  elif (( s < 86400 )); then printf '%dh%dm' $(( s / 3600 )) $(( s % 3600 / 60 ))
  else printf '%dd' $(( s / 86400 )); fi
}

# lbar <pct> <width> <fill> <empty>
lbar() {
  local pct=${1:-0} w=${2:-8} f=$3 e=$4 i filled
  (( pct < 0 )) && pct=0
  (( pct > 100 )) && pct=100
  filled=$(( pct * w / 100 ))
  for ((i = 0; i < w; i++)); do
    if (( i < filled )); then printf '%s' "$f"; else printf '%s' "$e"; fi
  done
}

# Limits meters, rendered inline on the summary line. build_limits collects one
# segment per subscription into parallel arrays (kind, label, colour, rank and a
# few numbers); render_limits lays them out for a given width, dropping detail
# and then whole segments when space is short. rank: 3 = needs action (red),
# 2 = close to a cap (yellow), 1 = fine. limits_hit counts the rank-3 ones, for
# the pane title.
build_limits() {
  limits_hit=0
  seg_kind=() seg_label=() seg_c=() seg_rank=() seg_pct=() seg_wl=() seg_reset=() seg_state=() seg_age=()
  local -A metered=() want=()
  local -a order=()

  add() { seg_kind+=("$1"); seg_label+=("$2"); seg_c+=("$3"); seg_rank+=("$4"); }

  # Providers with a usage API: the window closest to its cap.
  local f name label status updated pct wl wr c rank
  shopt -s nullglob
  for f in "$LIMITS_DIR"/*.json; do
    IFS=$'\t' read -r name label status updated pct wl wr < <(jq -r '
      (.windows | max_by(.pct)) as $w
      | [ .name, .label, .status, .updated, ($w.pct // -1), ($w.label // "-"), ($w.resets // 0) ] | @tsv' "$f" 2>/dev/null) || continue
    [[ -n $name ]] || continue
    metered[$name]=1
    if [[ $status == auth ]]; then
      add auth "$label" "$yellow" 3
      continue
    fi
    (( pct >= 0 )) || continue
    c=$green rank=1
    (( pct >= LIMIT_WARN )) && { c=$yellow; rank=2; }
    if (( pct >= LIMIT_ALERT )); then c=$red rank=3; limits_hit=$(( limits_hit + 1 )); fi
    (( now - updated > STALE )) && c=$dim
    add meter "$label" "$c" "$rank"
    seg_pct+=("$pct") seg_wl+=("$wl")
    seg_reset+=("$(( wr > now ? wr - now : 0 ))") seg_state+=("ok") seg_age+=("0")
  done

  # No usage API: "ok" means no limit has been seen, not that headroom is
  # confirmed. No bar — a hatched bar carried no information.
  local pid plabel ts_epoch age
  local -A plabels=()
  local tracked=${AGENT_LIMITS_TRACK:-} item
  if [[ -z $tracked && -r $LIMITS_PROVIDERS ]]; then   # older "providerID LABEL" file
    tracked=$(sed -e '/^[[:space:]]*#/d' -e 's/[[:space:]]\+/:/' "$LIMITS_PROVIDERS" | tr '\n' ' ')
  fi
  for item in $tracked; do
    pid=${item%%:*} plabel=
    [[ $item == *:* ]] && plabel=${item#*:}
    [[ -n $pid ]] || continue
    order+=("$pid"); plabels[$pid]=${plabel:-$(short_label "$pid")}
  done
  for pid in "${!lim_state[@]}"; do
    [[ ${lim_state[$pid]} == FAIL ]] || continue
    [[ -n ${plabels[$pid]:-} ]] || { order+=("$pid"); plabels[$pid]=$(short_label "$pid"); }
  done
  for pid in "${order[@]}"; do
    [[ -n ${metered[$pid]:-} || -n ${want[$pid]:-} ]] && continue
    want[$pid]=1
    plabel=${plabels[$pid]}
    ts_epoch=0
    if [[ ${lim_state[$pid]:-OK} == FAIL ]]; then
      ts_epoch=$(date -d "${lim_ts[$pid]}" +%s 2>/dev/null || echo 0)
      age=$(( now - ts_epoch ))
    fi
    if (( ts_epoch > 0 && age < LIMIT_HOLD )); then
      add state "$plabel" "$bold$red" 3
      seg_pct+=(100) seg_wl+=(-) seg_reset+=(0) seg_state+=(FAIL) seg_age+=("$age")
      limits_hit=$(( limits_hit + 1 ))
    else
      add state "$plabel" "$green" 1
      seg_pct+=(0) seg_wl+=(-) seg_reset+=(0) seg_state+=(OK) seg_age+=(0)
    fi
  done
}

# render_limits <wide|narrow> <min-rank> <avail>
#   wide:   DP ▓▓▓░ 85% day ↻2h     narrow: DP 85%     (no bar, no window)
# Stops before adding a segment that would not fit, so the line never wraps.
# Bar cells and ↻ are multi-byte, so width is measured on `pm`, an ASCII twin.
render_limits() {
  local mode=$1 min_rank=$2 avail=$3 i p pm n=0 space r
  limits_line= limits_plain= limits_elig=0
  local -a idx=()
  if (( min_rank > 0 )); then   # cramped: most urgent first, so it is not the one cut
    for r in 3 2 1; do
      for i in "${!seg_kind[@]}"; do (( seg_rank[i] == r )) && idx+=("$i"); done
    done
  else
    idx=("${!seg_kind[@]}")
  fi
  for i in "${idx[@]}"; do
    (( seg_rank[i] >= min_rank )) || continue
    limits_elig=$(( limits_elig + 1 ))
    case ${seg_kind[i]} in
      meter)
        p=${seg_label[i]} pm=${seg_label[i]}
        if [[ $mode == wide ]]; then
          p+=" $(lbar "${seg_pct[i]}" 4 '▓' '░')"; pm+=" xxxx"
        fi
        p+=" ${seg_pct[i]}%"; pm+=" ${seg_pct[i]}%"
        if [[ $mode == wide ]]; then
          if [[ ${seg_wl[i]} != - ]]; then p+=" ${seg_wl[i]}"; pm+=" ${seg_wl[i]}"; fi
          if (( seg_rank[i] == 3 && seg_reset[i] > 0 )); then
            p+=" ↻$(dur "${seg_reset[i]}")"; pm+=" ~$(dur "${seg_reset[i]}")"
          fi
        fi ;;
      auth)
        p="${seg_label[i]} key?"; pm=$p ;;
      state)
        if [[ ${seg_state[i]} == FAIL ]]; then
          p="${seg_label[i]} LIMIT $(dur "${seg_age[i]}")"
          [[ $mode == wide ]] && p+=" ago"
        else
          p="${seg_label[i]} ok"
        fi
        pm=$p ;;
    esac
    space=$(( n > 0 ? 3 : 0 ))   # " · "
    (( ${#limits_plain} + space + ${#pm} <= avail )) || break
    if (( n > 0 )); then limits_line+=' · '; limits_plain+=' · '; fi
    limits_line+="${seg_c[i]}${p}${off}"; limits_plain+=$pm
    n=$(( n + 1 ))
  done
  limits_n=$n
}

# Drop-ladder state. COL_W[n] is the rendered width with the first n optional
# columns shown, in reveal order: PROJECT, COST, TITLE, MODEL, HARNESS, GIT, PR,
# SUB (nested — n columns means the first n). HARNESS sits mid-ladder: the cc_/
# ses_ id prefix already shows the harness, so the HRN column is a convenience —
# it is dropped before GIT/PR/SUB but kept once there is real room. HYST is how
# many spare columns are required before revealing another column. It must stay
# below the smallest gap between consecutive thresholds (3, at the HRN step).
COL_W=(53 66 74 91 110 113 128 136 141)
HYST=2
prev_n=8

# Redraw promptly on resize. `wait` returns as soon as a trapped signal arrives,
# whereas `sleep` ignores SIGWINCH, so a resize is noticed in ~ms instead of
# after the full 2s tick. The trap kills the background sleep so ticks cannot
# pile up, and `resized` also skips the sleep if the signal landed mid-frame.
resized=0
slp=
trap 'resized=1; [[ -n $slp ]] && kill "$slp" 2>/dev/null' WINCH

# Pane size, read live from the controlling terminal. `tput cols`/`tput lines`
# trust the COLUMNS/LINES environment, which inside a Zellij pane can be stale
# or 0 (the pane was created narrow, or the var was exported before the layout
# settled) — that pins the inbox to 80 cols in a much wider pane. Reading the
# size straight off the terminal with `stty` tracks the real pane size through
# every resize. We query fd 2 (stderr), which stays attached to the pane's tty
# even when stdout is redirected, and guard it so a missing tty falls through to
# tput and then a sane default without erroring (there may be no tty at all).
term_size() {
  local sz=
  if [[ -t 2 ]]; then
    sz=$(stty size <&2 2>/dev/null)
  elif { : < /dev/tty; } 2>/dev/null; then
    sz=$(stty size < /dev/tty 2>/dev/null)
  fi
  if [[ $sz =~ ^([0-9]+)[[:space:]]+([0-9]+)$ ]]; then
    TROWS=${BASH_REMATCH[1]}; TCOLS=${BASH_REMATCH[2]}; return
  fi
  TCOLS=$(tput cols 2>/dev/null); [[ $TCOLS =~ ^[0-9]+$ ]] || TCOLS=120
  TROWS=$(tput lines 2>/dev/null); [[ $TROWS =~ ^[0-9]+$ ]] || TROWS=40
}

# Git status cache: running `git status` every 2s over up to 12 projects is too
# slow, so each directory is checked at most every GIT_INTERVAL seconds. Values
# are ASCII so the GIT column pads cleanly: "." = not a repo, "branch" = clean,
# "branch+N" = N changed files.
GIT_INTERVAL=30
declare -A g_last=() g_repo=() g_n=() g_branch=()

# PR/CI cache: `gh pr view` is a network call, so check at most every PR_INTERVAL
# seconds per directory. Values are ASCII so the PR column pads cleanly: "-" =
# no open PR, "#N" = CI green, "#N!" = failing, "#N?" = pending/draft.
PR_INTERVAL=60
declare -A pr_last=() pr_cell=()

while true; do
  now=$(date +%s)
  term_size; cols=$TCOLS
  (( cols > 40 )) || cols=120

  # Pick up archive changes made by `sa`/`sl` since the last tick. Disk is the
  # source of truth; the auto-unarchive path below writes back before the next
  # read, so this cannot clobber a mark the loop just cleared.
  load_archived
  # Pick how many optional columns fit, with hysteresis so resizing by a column
  # or two does not flip a column on and off. Shrink immediately while the pane
  # is narrower than the current layout (fit beats stability); grow only when
  # there are HYST columns to spare. COL_W values include every trailing space,
  # so `width` is the base layout width (TITLE and MODEL at their minimums); the
  # leftover `cols - width` is split between TITLE, MODEL and a spacer before
  # TOKENS further down.
  n=$prev_n
  while (( n > 0 && cols < COL_W[n] )); do n=$(( n - 1 )); done
  while (( n < 8 && cols >= COL_W[n + 1] + HYST )); do n=$(( n + 1 )); done
  prev_n=$n
  width=${COL_W[n]}

  # Reveal order: PROJECT, COST, TITLE, MODEL, HARNESS, GIT, PR, SUB.
  show_hrn=0; show_proj=0; show_cost=0; show_title=0; show_model=0
  show_git=0; show_pr=0; show_sub=0
  (( n >= 1 )) && show_proj=1
  (( n >= 2 )) && show_cost=1
  (( n >= 3 )) && show_title=1
  (( n >= 4 )) && show_model=1
  (( n >= 5 )) && show_hrn=1
  (( n >= 6 )) && show_git=1
  (( n >= 7 )) && show_pr=1
  (( n >= 8 )) && show_sub=1

  # Map log events onto sessions. The log tag is the id prefix — 8 chars in
  # lines written so far, 12 in newer plugin versions. The leading chars are
  # time-derived, so prefix collisions do happen; an ambiguous tag is dropped
  # rather than pinned on the wrong session.
  source_fetch
  data=$(source_sessions)
  spend=$(source_spend)
  [[ $spend =~ ^-?[0-9] ]] || spend=0

  if [[ -n $LIMITS_BIN ]] && (( now - last_refresh >= LIMITS_REFRESH )); then
    last_refresh=$now
    "$LIMITS_BIN" refresh >/dev/null 2>&1 &
    disown 2>/dev/null
  fi

  # Flex the leftover width across the content columns instead of dumping it all
  # into TITLE. PROJECT grows first (so full project names show when there's
  # room), then TITLE, then MODEL — each only until its longest value fits.
  # Whatever is left becomes a spacer between the content columns and TOKENS, so
  # the numeric columns stay right-aligned at the pane edge.
  max_title=0 max_model=0 max_proj=0
  while IFS=$'\t' read -r _harness _id _upd _busy _dir stitle _tot _cost _kids _bk agent modelid; do
    [[ -n $_id ]] || continue
    (( ${#stitle} > max_title )) && max_title=${#stitle}
    mm="${agent:+$agent/}$modelid"
    (( ${#mm} > max_model )) && max_model=${#mm}
    _pname=${_dir##*/}
    (( ${#_pname} > max_proj )) && max_proj=${#_pname}
  done <<< "$data"

  title_w=16 model_w=18 proj_w=12 spacer=0
  extra=$(( cols - width )); (( extra < 0 )) && extra=0
  if (( show_proj )); then
    # PROJECT grows first (up to the longest project name) so full names show
    # when there is room; the 12-col base is already baked into COL_W/width.
    proj_need=$(( max_proj > 12 ? max_proj - 12 : 0 ))
    p=$(( extra < proj_need ? extra : proj_need ))
    proj_w=$(( 12 + p )); extra=$(( extra - p ))
  fi
  if (( show_title )); then
    title_need=$(( max_title > 16 ? max_title - 16 : 0 ))
    a=$(( extra < title_need ? extra : title_need ))
    title_w=$(( 16 + a )); extra=$(( extra - a ))
    if (( show_model )); then
      model_need=$(( max_model > 18 ? max_model - 18 : 0 ))
      b=$(( extra < model_need ? extra : model_need ))
      model_w=$(( 18 + b )); extra=$(( extra - b ))
    fi
    spacer=$extra
  else
    # TITLE is hidden, so whatever width is left (after PROJECT grew) is spacer.
    spacer=$extra
  fi

  budget=${AGENT_BUDGET:-}
  [[ -z $budget && -r $BUDGET_FILE ]] && budget=$(head -n1 "$BUDGET_FILE" 2>/dev/null | tr -d '[:space:]')

  # Which session is in the pane that has focus right now? `so`/`sc`/`sn` put the ID in
  # the pane title; anything else (a plain shell, this pane) yields nothing.
  focused_ses=
  if [[ -n ${ZELLIJ_PANE_ID:-} ]]; then
    focused_ses=$(zellij action list-panes --json 2>/dev/null |
      jq -r '[.[] | select(.is_focused and (.is_plugin | not)) | .title][0] // empty' 2>/dev/null |
      grep -oE 'ses_[A-Za-z0-9]{20,}' | head -n 1)
  fi

  unset ev; declare -A ev=()
  unset lim_state lim_ts prov_of; declare -A lim_state=() lim_ts=() prov_of=()
  while IFS=$'\t' read -r _h _sid _p; do [[ -n $_sid ]] && prov_of[$_sid]=$_p; done < <(source_providers)
  if [[ -r $LOG && -n $data ]]; then
    unset ltag ltext lts; declare -a ltag=() ltext=() lts=()
    while IFS= read -r line; do
      tag=${line#*] [}                 # "ses_e539 brain] FAILED provider.quota: ..."
      [[ $tag == *'] '* ]] || continue
      text=${tag#*] }                  # "FAILED provider.quota: ..."
      case ${text%% *} in
        WAITING|RESUMED|IDLE|INTERRUPTED|RETRY|FAILED|LOADED)
          ltag+=("${tag%% *}"); ltext+=("$text"); lts+=("${line:1:19}") ;;
      esac
    done < <(tail -n 400 "$LOG" 2>/dev/null)

    unset ids; declare -a ids=()
    while IFS=$'\t' read -r _ id _; do [[ -n $id ]] && ids+=("$id"); done <<< "$data"

    # Log lines are in time order, so the last quota failure or success seen
    # for a provider decides its state. The log tag is an id prefix, so look
    # the full id up among all sessions, not just the rows shown.
    for i in "${!ltag[@]}"; do
      t=${ltag[i]} hits=0 hit=
      for id in "${ids[@]}"; do
        if [[ $id == "$t"* ]]; then hits=$(( hits + 1 )); hit=$id; fi
      done
      (( hits == 1 )) && ev[$hit]=${ltext[i]}
      case ${ltext[i]} in
        "FAILED provider.quota"*|IDLE*)
          hits=0 hit=
          for id in "${!prov_of[@]}"; do
            if [[ $id == "$t"* ]]; then hits=$(( hits + 1 )); hit=$id; fi
          done
          if (( hits == 1 )); then
            p=${prov_of[$hit]}
            case ${ltext[i]} in
              IDLE*) lim_state[$p]=OK ;;
              *)     lim_state[$p]=FAIL; lim_ts[$p]=${lts[i]} ;;
            esac
          fi ;;
      esac
    done
  fi

  rows= urgent=0 running=0
  unset UNARCHIVE; declare -a UNARCHIVE=()
  while IFS=$'\t' read -r harness id upd busy dir stitle tot cost kids busykids agent modelid; do
    [[ -n $id ]] || continue
    age=$(( now - upd ))
    if (( age < 3600 )); then a="$(( age / 60 ))m"
    elif (( age < 86400 )); then
      h=$(( age / 3600 )); m=$(( age % 3600 / 60 ))
      if (( m == 0 )); then a="${h}h"; else a="${h}h${m}m"; fi
    else a="$(( age / 86400 ))d"; fi

    # A pending permission request outranks busy/idle: the agent is blocked
    # even though its busy flag may still be set.
    st= c=
    e=${ev[$id]:-}
    case $e in
      WAITING*)     st=ASK;       c=$yellow; urgent=$(( urgent + 1 )) ;;
      FAILED*)      st=FAIL;      c=$red;    urgent=$(( urgent + 1 )) ;;
      INTERRUPTED*) st=STOP;      c=$yellow ;;
    esac

    if [[ -z $st ]]; then
      if (( busy == 1 && age > 900 )); then
        # Busy flag still set but no update for 15m: the run died mid-flight
        # (quota, crash, kill) and will never finish. Streaming output updates
        # the session continuously, so this does not catch slow-but-alive runs.
        st=DEAD; c=$red; urgent=$(( urgent + 1 ))
      elif (( busy == 1 )); then st=RUN; c=$green; running=$(( running + 1 ))
      else st=IDLE; c=$yellow; fi
    fi

    # Archived ("done") sessions are hidden from the live pane — unless they
    # need you again (ASK/FAIL/DEAD/STOP), in which case show them and clear the
    # mark so "done" can never bury something urgent. In --all mode nothing is
    # archived (ARCHIVED is empty), so every row is shown and flagged below.
    if [[ -n ${ARCHIVED[$id]:-} ]]; then
      case $st in
        ASK|FAIL|DEAD|STOP) UNARCHIVE+=("$id"); unset "ARCHIVED[$id]" ;;
        *) continue ;;
      esac
    fi

    # Rows needing attention rise to the top, then working, then idle.
    case $st in
      ASK|FAIL|DEAD|STOP) rank=0 ;;
      RUN) rank=1 ;;
      *) rank=2 ;;
    esac

    row=$(printf '%s%-4s%s %-6s ' "$bold$c" "$st" "$off" "$a")
    # SESSION cell: pad the id to the header's 30-char field width. Colour codes
    # confuse printf's %-30s (it counts the escape bytes), so pad the *visible*
    # string first, then wrap in colour. cc_ ids are much shorter than ses_ ids,
    # so without this the columns after SESSION would not line up.
    if [[ -n $focused_ses && $id == "$focused_ses" ]]; then
      row+=$(printf '%s%-30s%s ' "$rev" "$id" "$off")
    elif (( ALL_MODE )) && [[ -n ${ARCHIVED_FLAG[$id]:-} ]]; then
      # Long-tail list: flag archived rows so "done" sessions are visible but
      # distinguishable. A trailing " (archived)" is cheap and greppable.
      row+=$(printf '%s%-30s%s ' "$dim" "$id (archived)" "$off")
    else
      row+=$(printf '%s%-30s%s ' "$dim" "$id" "$off")
    fi
    (( show_proj )) && row+=$(printf "%-${proj_w}s " "$(clip "${dir##*/}" "$proj_w")")
    (( show_title )) && row+=$(printf "%-${title_w}s " "$(clip "$stitle" "$title_w")")
    modelstr="${agent:+$agent/}$modelid"
    (( show_model )) && row+=$(printf "%-${model_w}s " "$(clip "$modelstr" "$model_w")")
    (( show_hrn )) && row+=$(printf '%s%-2s%s ' "$dim" "$(harness_label "$harness")" "$off")
    if (( show_git )); then
      gcell= gcol=$dim
      if [[ -z $dir ]]; then
        gcell="."
      else
        if (( now - ${g_last[$dir]:-0} >= GIT_INTERVAL )); then
          g_last[$dir]=$now
          if [[ -d "$dir/.git" || -f "$dir/.git" ]]; then
            g_repo[$dir]=1
            g_n[$dir]=$(git -C "$dir" status --porcelain 2>/dev/null | wc -l | tr -d ' ')
            g_branch[$dir]=$(git -C "$dir" rev-parse --abbrev-ref HEAD 2>/dev/null)
          else
            g_repo[$dir]=0
          fi
        fi
        if [[ ${g_repo[$dir]:-0} == 0 ]]; then
          gcell="."
        else
          gcell=$(clip "${g_branch[$dir]:-?}" 10)
          if (( ${g_n[$dir]:-0} == 0 )); then
            gcol=$green
          else
            gcell="$gcell+${g_n[$dir]}"
            gcol=$yellow
          fi
        fi
      fi
      row+=$(printf '%s%-14s%s ' "$gcol" "$gcell" "$off")
    fi
    if (( show_pr )); then
      pcell=- pcol=$dim
      if [[ -n $dir && ${g_repo[$dir]:-0} == 1 ]]; then
        if (( now - ${pr_last[$dir]:-0} >= PR_INTERVAL )); then
          pr_last[$dir]=$now
          branch=${g_branch[$dir]:-}
          pr_cell[$dir]="-"
          if [[ -n $branch ]]; then
            pr_cell[$dir]=$(cd "$dir" && timeout 8 gh pr view "$branch" --json number,state,isDraft,statusCheckRollup 2>/dev/null |
              jq -r '
                if (. | type) != "object" or .state != "OPEN" then "-"
                elif .isDraft then "#\(.number)?"
                else
                  ([.statusCheckRollup[]? | select(.conclusion == "FAILURE")] | length) as $fail
                  | ([.statusCheckRollup[]? | select(.status != "COMPLETED")] | length) as $pend
                  | if $fail > 0 then "#\(.number)!"
                    elif $pend > 0 then "#\(.number)?"
                    else "#\(.number)" end
                end' 2>/dev/null)
            [[ -n ${pr_cell[$dir]} ]] || pr_cell[$dir]="-"
          fi
        fi
        pcell=${pr_cell[$dir]:-"-"}
        case $pcell in
          -) pcol=$dim ;;
          *!) pcol=$red ;;
          *?) pcol=$yellow ;;
          *) pcol=$green ;;
        esac
      fi
      row+=$(printf '%s%-7s%s ' "$pcol" "$pcell" "$off")
    fi
    if (( show_sub )); then
      if (( kids > 0 )); then
        sc=$dim; (( busykids > 0 )) && sc=$yellow
        row+=$(printf '%s%-4s%s ' "$sc" "$kids" "$off")
      else
        row+=$(printf '%s%-4s%s ' "$dim" "-" "$off")
      fi
    fi
    toks=-; (( tot > 0 )) && toks=$(human "$tot")
    row+=$(printf '%*s' "$spacer" '')
    row+=$(printf '%-6s ' "$toks")
    if (( show_cost )); then
      costs=-
      if [[ $cost != 0 && $cost != 0.0 ]]; then
        costs=$(printf '$%.2f' "$cost"); [[ $costs == '$0.00' ]] && costs='<$0.01'
      fi
      row+=$(printf '%-7s ' "$costs")
    fi
    rows+="$rank"$'\t'"$age"$'\t'"$id"$'\t'"$row"$'\n'
  done <<< "$data"

  # Auto-unarchive: a session marked "done" that came back needing you was shown
  # above and dropped from ARCHIVED in the loop. Persist that by rewriting the
  # file atomically, but only when the set actually shrank, so a quiet render
  # never touches disk. (Never in --all mode: that read-only view keeps marks.)
  if (( ! ALL_MODE )) && (( ${#UNARCHIVE[@]} > 0 )); then
    tmp=$(mktemp "${ARCHIVED_FILE}.XXXXXX" 2>/dev/null) && {
      for _aid in "${!ARCHIVED[@]}"; do printf '%s\n' "$_aid"; done | sort > "$tmp"
      mv -f "$tmp" "$ARCHIVED_FILE"
    }
  fi

  # One-line summary: what needs you, what's running, and rolling 24h spend.
  spends=-
  if [[ $spend != 0 && $spend != 0.0 && -n $spend ]]; then
    spends=$(printf '$%.2f' "$spend"); [[ $spends == '$0.00' ]] && spends='<$0.01'
  fi
  over=0
  if [[ -n $budget && $budget =~ ^[0-9]+([.][0-9]+)?$ ]]; then
    awk -v a="$spend" -v b="$budget" 'BEGIN { exit !(a >= b) }' && over=1
  fi
  summary= summary_plain=
  if (( urgent > 0 )); then
    summary+="${red}⚠${urgent} need you${off} · "
    summary_plain+="⚠${urgent} need you · "
  fi
  summary+="${green}${running} RUN${off}"; summary_plain+="${running} RUN"
  if [[ $spends != - ]]; then
    summary+=" · "
    (( over )) && summary+="$red"
    summary+="${spends}/24h"
    (( over )) && summary+="$off"
    summary_plain+=" · ${spends}/24h"
  fi

  # The meters share this line; give them whatever room is left, shrinking
  # them (no bar, no window) and then dropping ok providers as it runs out.
  avail=$(( cols - ${#summary_plain} - 3 ))
  build_limits
  render_limits wide 0 "$avail"
  (( limits_n < limits_elig )) && render_limits narrow 0 "$avail"
  (( limits_n < limits_elig )) && render_limits narrow 2 "$avail"
  (( limits_n < limits_elig )) && render_limits narrow 3 "$avail"
  if [[ -n $limits_line ]]; then summary+=' · '"$limits_line"; fi
  top=$summary

  header=$(printf '%s%-3s%-4s %-6s ' "$bold" '#' STS AGE)
  header+=$(printf '%-30s ' SESSION)
  (( show_proj )) && header+=$(printf "%-${proj_w}s " PROJECT)
  (( show_title )) && header+=$(printf "%-${title_w}s " TITLE)
  (( show_model )) && header+=$(printf "%-${model_w}s " MODEL)
  (( show_hrn ))   && header+=$(printf '%-2s ' HRN)
  (( show_git ))   && header+=$(printf '%-14s ' GIT)
  (( show_pr ))    && header+=$(printf '%-7s ' PR)
  (( show_sub ))   && header+=$(printf '%-4s ' SUB)
  header+=$(printf '%*s' "$spacer" '')
  header+=$(printf '%-6s ' TOKENS)
  (( show_cost )) && header+=$(printf '%-7s ' COST)
  header+=$off

  if [[ -n $rows ]]; then
    lines=$TROWS
    max_rows=$(( lines - 3 )); (( max_rows < 5 )) && max_rows=5
    # --all prints every row once (no pane cap); the live pane caps to its height.
    (( ALL_MODE )) && max_rows=1000000
    # Sort rows by status rank (attention first), then by age so that within a
    # status the most recently active session is on top — that is the best proxy
    # for "what I'm working on". The age tiebreak also stops one harness's rows
    # (which arrive grouped and pre-sorted) from clustering ahead of the other's.
    sorted=$(printf '%s' "$rows" | sort -t$'\t' -k1,1n -k2,2n | head -n "$max_rows")
    body= n=0 listed=
    while IFS=$'\t' read -r _ _ sid line; do
      n=$(( n + 1 ))
      body+=$(printf '%s%2d%s ' "$dim" "$n" "$off")"$line"$'\n'
      listed+="$sid"$'\n'
    done <<< "$sorted"
    # Don't clobber the live row→id mapping with the uncapped --all order.
    (( ALL_MODE )) || printf '%s' "$listed" > "$SESSION_LIST"
    frame="$top"$'\n'"$header"$'\n'"${body%$'\n'}"
  else
    (( ALL_MODE )) || : > "$SESSION_LIST"
    frame="$top"$'\n'"$header"$'\n'"${dim}no sessions in the last 24h${off}"
  fi

  # --all is a one-shot snapshot: print and exit, no pane title, no live loop.
  if (( ALL_MODE )); then
    printf '%s\n' "$frame"
    exit 0
  fi

  pane_title=$BASE_NAME
  (( urgent > 0 )) && pane_title+=" ⚠${urgent}"
  (( limits_hit > 0 )) && pane_title+=" · limit ${limits_hit}"
  if [[ -n ${ZELLIJ_PANE_ID:-} && $pane_title != "$prev_title" ]]; then
    zellij action rename-pane -p "$ZELLIJ_PANE_ID" "$pane_title" >/dev/null 2>&1
    prev_title=$pane_title
  fi

  if [[ $cols$frame != "$prev" ]]; then
    clear
    printf '%s\n' "$frame"
    prev=$cols$frame
  fi
  if (( ! resized )); then
    sleep 2 & slp=$!
    wait "$slp" 2>/dev/null
  fi
  resized=0
done
