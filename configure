#!/usr/bin/env bash
# configure — interactive setup for agent-ops.
#
# Writes:
#   ~/.config/agent-ops/config       every setting (sourced by the scripts)
#   ~/.config/agent-ops/ntfy-topic   phone-push secret (optional, chmod 600)
# Secrets (ntfy-topic, devpass-key) stay in their own chmod 600 files.
#   ~/.config/zellij/layouts/agent-ops.kdl   a layout for your projects
# Idempotent: re-run to change answers.
set -euo pipefail

REPO="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
CFG_DIR="$HOME/.config/agent-ops"
CFG="$CFG_DIR/config"
mkdir -p "$CFG_DIR"

# Existing answers become the defaults, so re-running is safe.
if [[ -r $CFG ]]; then
  # shellcheck disable=SC1090
  source "$CFG"
fi

say()  { printf '%s\n' "$*"; }
ask()  { # ask <prompt> <default>  ->  prints the answer ("-" answers blank)
  local prompt=$1 default=${2:-} ans
  printf '%s [%s]: ' "$prompt" "$default" >&2
  IFS= read -r ans
  [[ -z $ans ]] && ans=$default
  [[ $ans == - ]] && ans=          # "-" clears a value that has a default
  printf '%s' "$ans"
}
yesno() { # yesno <prompt> [y|n]  ->  0 for yes, 1 for no
  local prompt=$1 default=${2:-y} ans hint
  if [[ $default == y ]]; then hint="[Y/n]"; else hint="[y/N]"; fi
  printf '%s %s: ' "$prompt" "$hint"
  IFS= read -r ans
  ans=${ans:-$default}
  case $ans in [yY]*) return 0 ;; *) return 1 ;; esac
}

say "agent-ops configuration"
say "======================"
say

# --- dependencies ---
say "Checking dependencies…"
missing=()
for c in jq zellij git curl opencode; do
  command -v "$c" >/dev/null 2>&1 || missing+=("$c")
done
command -v notify-send >/dev/null 2>&1 || say "  · notify-send not found — desktop popups will be off"
command -v docker >/dev/null 2>&1    || say "  · docker not found — the sys pane will show it down"
if (( ${#missing[@]} )); then
  say "  · missing: ${missing[*]}"
  say "    install them, then re-run configure."
fi
say

# --- paths (defaults are fine for most) ---
log_path=$(ask "Log file" "${AGENT_LOG:-$HOME/agent-runs/agent_health.log}")
cache_path=$(ask "Session-list cache" "${AGENT_SESSION_LIST:-${XDG_CACHE_HOME:-$HOME/.cache}/opencode-session-list}")

# --- session sources (adapter seam) ---
say
say "Harnesses to watch in the inbox (space-separated): opencode, claude"
say "  opencode = the OpenCode server API; claude = Claude Code transcripts."
sources=$(ask "Sources" "${AGENT_SOURCES:-opencode}")
[[ -n $sources ]] || sources=opencode
source_name=$sources

# Default harness for `sn`/`sc` with no -o/-c flag. Only worth asking when more
# than one harness is watched; with opencode alone the answer is always opencode.
default_harness=${AGENT_DEFAULT_HARNESS:-opencode}
if [[ " $source_name " == *" claude "* ]]; then
  say
  say "Default harness for 'sn'/'sc' with no flag (sn -o / sn -c always override)."
  default_harness=$(ask "Default harness (opencode|claude)" "$default_harness")
  case $default_harness in
    opencode|claude) ;;
    *) say "  '$default_harness' is not opencode|claude — using opencode."; default_harness=opencode ;;
  esac
fi

# --- notifications ---
desktop=0 phone=0
if command -v notify-send >/dev/null 2>&1; then
  yesno "Desktop notifications (notify-send)?" y && desktop=1
fi
if command -v curl >/dev/null 2>&1 && yesno "Phone notifications via ntfy.sh?" n; then
  phone=1
fi

# --- budget ---
old_budget=${AGENT_BUDGET:-}
if [[ -z $old_budget && -r $CFG_DIR/budget ]]; then
  old_budget=$(head -n1 "$CFG_DIR/budget" | tr -d '[:space:]')
fi
budget=$(ask "Daily budget cap in dollars (blank = none)" "$old_budget")

# --- subscription limits ---
old_track=${AGENT_LIMITS_TRACK:-}
if [[ -z $old_track && -r $CFG_DIR/limits-providers ]]; then
  old_track=$(sed -e '/^[[:space:]]*#/d' -e 's/[[:space:]]\+/:/' "$CFG_DIR/limits-providers" | tr '\n' ' ')
  old_track=${old_track% }
fi
say
say "Limits line: providers with no usage API get a hatched bar that goes red on a quota error."
say "  format: providerID:LABEL, space-separated (e.g. google:GG opencode-go:GO)"
say "  DevPass is metered automatically if \$DEVPASS_API_KEY or $CFG_DIR/devpass-key is set."
track=$(ask "Providers to track" "$old_track")

# --- write config ---
umask 077
cat > "$CFG" <<EOF
# agent-ops config — generated by $0
AGENT_SOURCES="$source_name"
AGENT_LOG="$log_path"
AGENT_SESSION_LIST="$cache_path"
EOF
[[ -n $budget ]] && printf 'AGENT_BUDGET=%s\n' "$budget" >> "$CFG"
[[ -n $track ]]  && printf 'AGENT_LIMITS_TRACK="%s"\n' "$track" >> "$CFG"
# Only written when it differs from the built-in default (opencode), so
# OpenCode-only configs stay minimal.
[[ $default_harness == claude ]] && printf 'AGENT_DEFAULT_HARNESS="%s"\n' "$default_harness" >> "$CFG"
# Tunables, left at their defaults. Uncomment to change.
cat >> "$CFG" <<'EOF'
#AGENT_MAX_ROWS=12          # max sessions fetched/ranked (pane height caps what's drawn)
#AGENT_DEFAULT_HARNESS=opencode  # harness sn/sc use with no -o/-c flag (opencode|claude)
#AGENT_LIMIT_WARN=70        # limits line turns yellow at this percent
#AGENT_LIMIT_ALERT=90       # ... and red at this one
#AGENT_LIMIT_HOLD=86400     # seconds a quota failure is trusted without a later success
#AGENT_LIMITS_REFRESH=60    # seconds between background fetches
#AGENT_LIMIT_STALE=300      # seconds before a meter is shown dimmed
EOF
chmod 644 "$CFG"   # no secrets in here; ntfy-topic and devpass-key stay 600
say
say "wrote $CFG"

# --- phone topic ---
if (( phone )); then
  topic_file="$CFG_DIR/ntfy-topic"
  if [[ ! -s $topic_file ]]; then
    openssl rand -hex 16 > "$topic_file"
    chmod 600 "$topic_file"
  fi
  topic=$(<"$topic_file")
  say "phone notifications: subscribe to this ntfy topic in the app:"
  say "    $topic"
  say "  (server: ntfy.sh; the topic file is $topic_file, chmod 600)"
fi

# --- fold the older one-value files into config ---
for old in budget limits-providers; do
  if [[ -e $CFG_DIR/$old ]]; then
    rm -f "$CFG_DIR/$old"
    say "folded $CFG_DIR/$old into config"
  fi
done

# --- claude code hooks ---
# When the inbox watches Claude Code, it needs the agent-cc-log hook wired into
# Claude Code's settings so RUNNING/WAITING/IDLE land in the shared log. Merge
# (never clobber) into ~/.claude/settings.json with jq. Claude Code runs hooks
# through a non-interactive shell that usually lacks ~/.local/bin on PATH, so the
# command is written as an absolute path rather than the bare name.
if [[ " $source_name " == *" claude "* ]]; then
  cc_settings="$HOME/.claude/settings.json"
  cc_bin=$(command -v agent-cc-log 2>/dev/null || true)
  [[ -n $cc_bin ]] || cc_bin="$HOME/.local/bin/agent-cc-log"   # install.sh links it here
  say
  if command -v jq >/dev/null 2>&1; then
    if yesno "Wire the Claude Code hook (agent-cc-log) into $cc_settings?" y; then
      mkdir -p "$(dirname "$cc_settings")"
      [[ -s $cc_settings ]] || printf '{}\n' > "$cc_settings"
      cp "$cc_settings" "$cc_settings.agent-ops.bak"
      hook() { printf '[{"hooks":[{"type":"command","command":"%s %s"}]}]' "$cc_bin" "$1"; }
      if jq \
          --argjson run "$(hook run)" \
          --argjson notify "$(hook notify)" \
          --argjson stop "$(hook stop)" \
          --argjson substop "$(hook substop)" '
          .hooks = ((.hooks // {})
            | .UserPromptSubmit = $run
            | .Notification     = $notify
            | .Stop             = $stop
            | .SubagentStop     = $substop)
          ' "$cc_settings.agent-ops.bak" > "$cc_settings"; then
        say "  wired the hook into $cc_settings (backup: $cc_settings.agent-ops.bak)"
        say "  restart Claude Code sessions so the hook takes effect."
      else
        mv -f "$cc_settings.agent-ops.bak" "$cc_settings"
        say "  could not edit $cc_settings — left it unchanged."
      fi
    fi
  else
    say "  jq not found — skipping Claude Code hook setup."
  fi
fi

# --- zellij layout ---
if yesno "Generate a Zellij layout with your project directories?" y; then
  say "  list project directories, comma-separated (e.g. ~/pcode/agent-ant,~/pcode/brain):"
  printf '  dirs: '
  IFS= read -r dirs
  # shellcheck disable=SC2016
  panes=""
  first=1
  IFS=',' read -r -a arr <<< "$dirs"
  for d in "${arr[@]}"; do
    d=${d/#\~/$HOME}
    d=$(cd "$d" 2>/dev/null && pwd) || { say "  skipping (not a directory): $d"; continue; }
    name=$(basename "$d")
    if (( first )); then
      panes+="                pane name=\"$name\" cwd=\"$d\" focus=true expanded=true"$'\n'
      first=0
    else
      panes+="                pane name=\"$name\" cwd=\"$d\""$'\n'
    fi
  done
  if [[ -z $panes ]]; then
    panes='                pane name="home" cwd="'$HOME'" focus=true expanded=true'$'\n'
  fi
  layout_dir="$HOME/.config/zellij/layouts"
  mkdir -p "$layout_dir"
  target="$layout_dir/agent-ops.kdl"
  [[ -L $target ]] && rm -f "$target"   # replace the example symlink with a real file
  cat > "$target" <<EOF
// "Agent Ops" layout — generated by agent-ops configure
layout {
    default_tab_template {
        pane size=1 borderless=true {
            plugin location="zellij:tab-bar"
        }
        children
        pane size=2 borderless=true {
            plugin location="zellij:status-bar"
        }
    }

    tab name="Agent Ops" {
        pane split_direction="horizontal" {
            pane name="Agent Inbox" command="agent-inbox" size="21%"
            pane stacked=true size="70%" {
$panes            }
            pane name="System" command="sys" size="9%"
        }
    }
}
EOF
  say "wrote $target"
fi

# --- shell helpers ---
say
say "Shell helpers (so/sd/sc/sn/znp/zdp) live in:"
say "    $REPO/shell/agent-ops.zsh"
if yesno "Append a source line to ~/.zshrc?" y; then
  line="[[ -f \"$REPO/shell/agent-ops.zsh\" ]] && source \"$REPO/shell/agent-ops.zsh\""
  if grep -qF "$line" "$HOME/.zshrc" 2>/dev/null; then
    say "  already in ~/.zshrc"
  else
    printf '\n# agent-ops shell helpers\n%s\n' "$line" >> "$HOME/.zshrc"
    say "  added to ~/.zshrc (restart your shell to load it)"
  fi
fi

say
say "Done. Remaining manual steps:"
say "  1. restart OpenCode so the plugin loads:  opencode service restart"
if [[ " $source_name " == *" claude "* ]]; then
  say "  · restart Claude Code sessions so the agent-cc-log hook loads"
fi
if (( phone )); then
  say "  2. install the ntfy app and subscribe to the topic above"
fi
say "  3. use the 'Agent Ops' layout:  zellij --layout agent-ops"
